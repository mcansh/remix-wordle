{
	"name": "remix-wordle",
	"private": true,
	"description": "a wordle game made with Remix v3",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./*"
	},
	"scripts": {
		"build": "vite build",
		"check": "oxfmt --check && oxlint && tsc --noEmit",
		"dev": "vite dev",
		"format": "oxfmt",
		"lint": "oxlint --fix",
		"preview": "vite preview",
		"start": "node ./server.ts",
		"test": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--import ./test/register-node-hooks.mjs\" remix test",
		"test:e2e": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--import ./test/register-node-hooks.mjs\" remix test --type e2e --project chromium",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@mcansh/http-helmet": "catalog:",
		"@prisma/adapter-pg": "catalog:",
		"@prisma/client": "catalog:",
		"@standard-schema/spec": "catalog:",
		"bcryptjs": "catalog:",
		"better-result": "catalog:",
		"bullmq": "catalog:",
		"clsx": "catalog:",
		"date-fns": "catalog:",
		"ioredis": "catalog:",
		"pitlane": "catalog:",
		"remix": "catalog:"
	},
	"devDependencies": {
		"@mcansh/vite-plugin-svg-sprite": "catalog:",
		"@mswjs/http-middleware": "catalog:",
		"@oxlint/plugins": "catalog:",
		"@redwoodjs/agent-ci": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@total-typescript/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"msw": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"playwright": "catalog:",
		"prisma": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "catalog:"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
