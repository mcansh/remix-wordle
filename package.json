{
	"name": "remix-wordle",
	"private": true,
	"description": "a wordle game made with Remix v3",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"dev": "pnpm run \"/^dev:.*\"/",
		"dev:server": "NODE_ENV=development tsx --env-file .env --watch server.ts",
		"dev:css": "tailwindcss --input app/app.css --output public/build/app.css --watch",
		"build": "tailwindcss --input app/app.css --output public/build/app.css --minify",
		"start": "tsx server.ts",
		"lint": "oxlint",
		"format": "oxfmt",
		"test": "vitest",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@epic-web/invariant": "catalog:",
		"@mcansh/http-helmet": "catalog:",
		"@prisma/adapter-pg": "catalog:",
		"@prisma/client": "catalog:",
		"@standard-schema/spec": "catalog:",
		"bcryptjs": "catalog:",
		"bullmq": "catalog:",
		"clsx": "catalog:",
		"date-fns": "catalog:",
		"ioredis": "catalog:",
		"remix": "catalog:"
	},
	"devDependencies": {
		"@mcansh/remix-testing-library": "catalog:",
		"@mswjs/http-middleware": "catalog:",
		"@oxlint/plugins": "catalog:",
		"@tailwindcss/cli": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@total-typescript/shoehorn": "catalog:",
		"@total-typescript/tsconfig": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"better-result": "catalog:",
		"happy-dom": "catalog:",
		"msw": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"prisma": "catalog:",
		"tailwindcss": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
